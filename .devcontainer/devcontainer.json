
{
  "name": "Ubuntu Fullstack Development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [5173, 8000],
  "portsAttributes": {
    "5173": {
      "label": "Vite Frontend",
      "onAutoForward": "openBrowser"
    },
    "8000": {
      "label": "FastAPI Backend",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "saoudrizwan.claude-dev"
      ]
    }
  }
}
